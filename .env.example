# ---------------------------------------------------------------------------
# Template for backend/.env — copy to .env and fill in.
#
# Every key marked REQUIRED is checked at boot by src/config/env.validation.ts.
# The app will refuse to start if one is missing, too short, or still set to a
# placeholder value from this file. That is intentional: every one of these has
# a failure mode that is otherwise silent.
# ---------------------------------------------------------------------------

# --- App ---
NODE_ENV=production                 # development | production | test
PORT=4000
APP_URL=https://api.yourdomain.com

# --- Admin dashboard (REQUIRED when NODE_ENV=production) ---
# Origin *plus* the admin path prefix — this is where "View in dashboard"
# buttons in notification email point. Note this is the SITE, not the API, so
# it differs from APP_URL above. Set it to whatever the panel is actually
# served at (e.g. https://yourdomain.com/cpadmin or https://cpadmin.yourdomain.com);
# leaf routes like /contact-submissions are appended automatically.
# Trailing slash optional. Unset in development just omits the button.
ADMIN_BASE_URL=https://yourdomain.com/cpadmin

# --- Client portal (REQUIRED when NODE_ENV=production) ---
# Origin *plus* the portal path prefix. Used to build the accept-invite link
# sent to clients and staff (?uid=&token= is appended). Unset in development
# just ships a dead link in the invite email — same tradeoff as ADMIN_BASE_URL.
PORTAL_URL=https://yourdomain.com/portal

# How long an invite acceptance link stays valid, in hours.
INVITE_TOKEN_TTL_HOURS=72

# --- Mongo (REQUIRED) ---
# Must start with mongodb:// or mongodb+srv://. May not point at localhost
# while NODE_ENV=production.
MONGODB_URI=
DB_NAME=weblaud

# --- CORS (REQUIRED when NODE_ENV=production) ---
# Comma-separated scheme+host. No trailing slash, no path.
# An empty value in production blocks every browser request to the API,
# including the admin panel — so it is validated rather than defaulted.
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# --- JWT (REQUIRED) ---
# Minimum 32 characters each, and the two MUST differ — reusing one secret lets
# a refresh token be replayed as an access token.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# --- Google OAuth (career applicant login) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://yourdomain.com/api/v1/careers/google/callback

# --- File upload controls ---
# Both are enforced by multer (size limit + fileFilter) before any bytes reach
# the storage provider.
FILE_STORAGE=cloudinary             # local | s3 | cloudinary
FILE_MAX_SIZE=10mb
FILE_ALLOWED_TYPES=jpg,jpeg,png,webp,pdf,doc,docx,mp4,mov

# --- Cloudinary (REQUIRED when FILE_STORAGE=cloudinary) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- S3 (REQUIRED when FILE_STORAGE=s3) ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# --- Local storage (used when FILE_STORAGE=local) ---
LOCAL_UPLOAD_PATH=public/uploads

# --- Cookies ---
COOKIE_DOMAIN=yourdomain.com
COOKIE_SECURE=true

# --- Throttle ---
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# --- Website ↔ API trust (recommended in production) ---
# The website calls this API server-to-server, so without this every visitor
# looks like the website's own IP: one shared rate-limit bucket for the whole
# site, and contract acceptances recorded with the server's IP/user agent.
# With it set, the website forwards each visitor's IP/UA and this secret
# proves the forwarding is genuine. Must be IDENTICAL to INTERNAL_API_SECRET
# in weblaud-site/.env. 32+ characters; leave empty to disable.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
INTERNAL_API_SECRET=

# --- Cloudflare Turnstile (bot check on contact / estimate / job forms) ---
# Secret key from Cloudflare dashboard → Turnstile → your widget. The matching
# SITE key goes in weblaud-site/.env as TURNSTILE_SITE_KEY.
# Leave EMPTY until the website is deployed and sending tokens: while unset
# the forms are accepted without a check (logged as a warning); once set,
# every submission without a valid token is rejected.
TURNSTILE_SECRET_KEY=

# --- Mail (REQUIRED) ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USER=
MAIL_PASS=
MAIL_FROM="WebLaud <noreply@yourdomain.com>"

# Where contact submissions and project estimates are announced. REQUIRED —
# no fallback, because an unset value used to silently mail a dead address.
MAIL_ADMIN=

# Discovery-call link included in the automatic reply every contact/estimate
# lead receives. Optional; defaults to the site's zcal link.
BOOKING_URL=

# Google PageSpeed Insights API key for the free website audit tool (/audit).
# Free from Google Cloud Console (enable "PageSpeed Insights API"). Optional,
# but keyless requests share a global quota that is usually exhausted.
PAGESPEED_API_KEY=

# Where job applications are announced. Optional; defaults to MAIL_ADMIN.
MAIL_HR=

# Signs the unsubscribe-link tokens in transactional email footers (contract
# sent, invoice sent/overdue, approval requested, change request quoted,
# project update published). Optional — falls back to JWT_SECRET, which is
# already required and validated as strong. Set your own only if you want
# the two to differ.
EMAIL_UNSUBSCRIBE_SECRET=

# --- Stripe (optional — payments no-op with a logged error until all three are set) ---
# Checkout Session + webhook-verified payment confirmation. Test mode keys
# (sk_test_.../whsec_test_...) work identically to live for local dev; point
# the Stripe CLI at the webhook route: `stripe listen --forward-to
# localhost:4000/api/v1/payments/webhook`, then use the whsec_ it prints.
# The webhook endpoint in the Stripe dashboard must send these events:
#   checkout.session.completed, checkout.session.async_payment_succeeded,
#   checkout.session.async_payment_failed, checkout.session.expired
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# --- Admin seed ---
# Applied on first boot only. Changing these does not update an existing admin.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=User

{
  "name": "backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "local:up": "docker compose -f docker-compose.local.yml up -d",
    "local:down": "docker compose -f docker-compose.local.yml down",
    "start:local": "node scripts/local.js nest start --watch",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "migrate:content": "ts-node -r tsconfig-paths/register scripts/migrate-content.ts",
    "migrate:editorial": "ts-node -r tsconfig-paths/register scripts/migrate-editorial.ts",
    "migrate:publication": "ts-node -r tsconfig-paths/register scripts/migrate-publication.ts",
    "migrate:publication:local": "node scripts/local.js ts-node -r tsconfig-paths/register scripts/migrate-publication.ts",
    "seed:portal-demo": "ts-node -r tsconfig-paths/register scripts/seed-portal-demo.ts",
    "reconcile:budget-spent": "ts-node -r tsconfig-paths/register scripts/reconcile-budget-spent.ts",
    "reconcile:time-entry-locks": "ts-node -r tsconfig-paths/register scripts/reconcile-time-entry-locks.ts",
    "seed:local": "node scripts/local.js ts-node -r tsconfig-paths/register scripts/seed-portal-demo.ts",
    "digest:local": "node scripts/local.js ts-node -r tsconfig-paths/register scripts/send-digest-now.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1150.0",
    "@aws-sdk/lib-storage": "^3.1150.0",
    "@aws-sdk/s3-request-presigner": "^3.1150.0",
    "@nestjs/common": "^11.2.7",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.7",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mapped-types": "^2.1.1",
    "@nestjs/mongoose": "^11.0.4",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/throttler": "^6.7.1",
    "@sentry/nestjs": "^11.8.0",
    "@types/compression": "^1.8.1",
    "@weblaud/upload-pro": "^1.1.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "cloudinary": "^2.11.0",
    "compression": "^1.8.2",
    "fast-csv": "^5.0.8",
    "handlebars": "^4.7.10",
    "helmet": "^8.3.0",
    "mongoose": "^8.24.5",
    "nodemailer": "^10.1.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdfkit": "^0.17.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "stripe": "^22.6.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.39.5",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.7",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^16.5.0",
    "jest": "^30.5.2",
    "prettier": "^3.9.10",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.14",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "moduleNameMapper": {
      "^src/(.*)$": "<rootDir>/$1"
    },
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}

<div style="font-family: Arial, sans-serif; padding: 20px; color: #111827;">
  <h2 style="margin: 0 0 16px;">{{authorName}} mentioned you</h2>

  <p>Hi {{firstName}},</p>

  <p style="background: #f4f4f5; border-radius: 8px; padding: 12px 16px; color: #374151;">{{excerpt}}</p>

  <p style="margin: 28px 0;">
    <a
      href="{{actionUrl}}"
      style="background: #0a84ff; color: #ffffff; padding: 12px 24px; border-radius: 8px; text-decoration: none; font-weight: bold;"
    >
      View comment
    </a>
  </p>

  <p style="color: #6b7280; font-size: 13px;">If the button doesn't work, paste this into your browser: {{actionUrl}}</p>

  <br/>
  <strong>WebLaud Team</strong>

  <hr style="border: none; border-top: 1px solid #e5e7eb; margin: 24px 0 14px;" />
  <p style="font-size: 12px; color: #9ca3af;">
    You're receiving this because someone mentioned you in a comment.
    <a href="{{unsubscribeUrl}}" style="color: #6b7280;">Unsubscribe from mention emails</a>.
  </p>
</div>

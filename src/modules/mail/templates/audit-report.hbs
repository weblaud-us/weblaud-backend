{{!--
  The full website-audit report, emailed to the visitor who claimed it.
  Visitor-influenced values: `name` (filtered by greetingName) and `host`
  (validated by normalizeAuditUrl, loaded by Google) — host is printed as
  plain text, never as a link. Everything else comes from the PageSpeed
  response. Keep every interpolation {{escaped}}.

  Layout follows dashboard-alert.hbs: tables, inline styles, bgcolor on the
  CTA cell for Outlook.
--}}
<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Your website audit report</title>
  </head>
  <body style="margin:0;padding:0;background:#f4f4f5;">
    <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="background:#f4f4f5;">
      <tr>
        <td align="center" style="padding:24px 12px;">
          <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="600" style="width:100%;max-width:600px;background:#ffffff;border-radius:10px;">
            <tr>
              <td style="padding:32px;font-family:Arial,Helvetica,sans-serif;">

                <h1 style="margin:0 0 8px;font-size:20px;line-height:1.3;color:#111827;">{{#if name}}{{name}}, here's{{else}}Here's{{/if}} your website audit</h1>
                <p style="margin:0 0 20px;font-size:14px;line-height:1.6;color:#6b7280;">
                  {{host}} &middot; tested on {{device}} with Google Lighthouse
                </p>

                <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="width:100%;border-collapse:collapse;">
                  {{#each scores}}
                    <tr>
                      <td style="padding:10px 14px 10px 0;font-size:14px;color:#374151;border-bottom:1px solid #e5e7eb;">{{label}}</td>
                      <td style="padding:10px 14px 10px 0;font-size:18px;font-weight:bold;color:#111827;text-align:right;border-bottom:1px solid #e5e7eb;width:60px;">{{score}}</td>
                      <td style="padding:10px 0;font-size:13px;font-weight:bold;color:{{color}};text-align:right;border-bottom:1px solid #e5e7eb;width:100px;">{{status}}</td>
                    </tr>
                  {{/each}}
                </table>

                {{#if vitals.length}}
                  <h2 style="margin:28px 0 8px;font-size:12px;font-weight:bold;text-transform:uppercase;letter-spacing:0.05em;color:#6b7280;">Core Web Vitals (lab)</h2>
                  <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="width:100%;border-collapse:collapse;">
                    {{#each vitals}}
                      <tr>
                        <td style="padding:8px 14px 8px 0;font-size:13px;color:#374151;border-bottom:1px solid #f0f0f0;">{{label}}</td>
                        <td style="padding:8px 14px 8px 0;font-size:13px;font-weight:bold;color:#111827;text-align:right;border-bottom:1px solid #f0f0f0;">{{value}}</td>
                        <td style="padding:8px 0;font-size:12px;color:#9ca3af;text-align:right;border-bottom:1px solid #f0f0f0;">good: {{good}}</td>
                      </tr>
                    {{/each}}
                  </table>
                {{/if}}

                {{#if topIssues.length}}
                  <h2 style="margin:28px 0 8px;font-size:12px;font-weight:bold;text-transform:uppercase;letter-spacing:0.05em;color:#6b7280;">What we'd fix first</h2>
                  <ol style="margin:0;padding-left:20px;font-size:14px;line-height:1.6;color:#111827;">
                    {{#each topIssues}}
                      <li style="margin:0 0 10px;">
                        {{title}}
                        {{#if detail}}<br /><span style="font-size:12px;color:#6b7280;">{{detail}}</span>{{/if}}
                      </li>
                    {{/each}}
                  </ol>
                  {{#if moreIssues}}
                    <p style="margin:4px 0 0;font-size:13px;color:#6b7280;">…plus {{moreIssues}} we can walk you through.</p>
                  {{/if}}
                {{else}}
                  <p style="margin:24px 0 0;font-size:14px;line-height:1.6;color:#374151;">
                    Lighthouse found no significant issues — nicely done. If the site still isn't converting, that's usually a product or UX question rather than a technical one, and we're happy to look.
                  </p>
                {{/if}}

                <p style="margin:28px 0 8px;font-size:15px;line-height:1.6;color:#374151;">
                  Want these fixed? In a 15-minute call we'll go through the report with you and tell you what's worth doing, and what isn't.
                </p>

                <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:16px 0 24px;">
                  <tr>
                    <td align="center" bgcolor="#0a84ff" style="border-radius:8px;">
                      <a href="{{bookingUrl}}" target="_blank" style="display:inline-block;padding:13px 26px;font-family:Arial,Helvetica,sans-serif;font-size:15px;font-weight:bold;color:#ffffff;text-decoration:none;border-radius:8px;">Book a call</a>
                    </td>
                  </tr>
                </table>

                <p style="margin:0 0 16px;font-size:14px;line-height:1.6;color:#4b5563;">
                  Or just reply to this email with any questions.{{#if projectsUrl}} You can also <a href="{{projectsUrl}}" style="color:#2563eb;">see projects we've delivered</a>.{{/if}}
                </p>

                <hr style="border:none;border-top:1px solid #e5e7eb;margin:24px 0 14px;" />

                <p style="margin:0;font-size:12px;line-height:1.6;color:#9ca3af;">
                  Lab results from Google PageSpeed Insights at the time of the test; real-visitor numbers can differ. You're receiving this because this address was used to request a website audit at weblaud.com. If that wasn't you, you can ignore this email — we won't add you to any list.<br />
                  Weblaud LLC
                </p>

              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>

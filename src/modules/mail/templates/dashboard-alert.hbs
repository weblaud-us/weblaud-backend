{{!--
  Unified "something new landed in the dashboard" notification.

  Every value here originates from an unauthenticated public form, so every
  interpolation must stay {{escaped}} — never use {{{triple braces}}}.

  Email-client constraints: table-based layout, all styling inline, no flexbox
  or grid, and nothing the layout depends on inside the <style> block (Gmail
  strips it in some contexts; the media query below is progressive enhancement
  only). The CTA carries bgcolor on the <td> as well as CSS because that is
  what makes it render in Outlook.
--}}
<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{heading}}</title>
    <style>
      @media only screen and (max-width: 600px) {
        .wl-card { padding: 24px 20px !important; }
        .wl-label, .wl-value { display: block !important; width: 100% !important; white-space: normal !important; }
        .wl-label { padding-bottom: 2px !important; }
      }
    </style>
  </head>
  <body style="margin:0;padding:0;background:#f4f4f5;">
    <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="background:#f4f4f5;">
      <tr>
        <td align="center" style="padding:24px 12px;">

          <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="600" style="width:100%;max-width:600px;background:#ffffff;border-radius:10px;">
            <tr>
              <td class="wl-card" style="padding:32px;font-family:Arial,Helvetica,sans-serif;">

                <h1 style="margin:0 0 12px;font-size:20px;line-height:1.3;color:#111827;">{{heading}}</h1>

                <p style="margin:0 0 20px;font-size:15px;line-height:1.6;color:#374151;">
                  You have something new in the dashboard &mdash; please check the dashboard.
                </p>

                {{#if intro}}
                  <p style="margin:0 0 20px;font-size:14px;line-height:1.6;color:#6b7280;">{{intro}}</p>
                {{/if}}

                {{#each sections}}
                  {{#if title}}
                    <h2 style="margin:24px 0 8px;font-size:12px;font-weight:bold;text-transform:uppercase;letter-spacing:0.05em;color:#6b7280;">{{title}}</h2>
                  {{/if}}
                  <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="width:100%;border-collapse:collapse;">
                    {{#each rows}}
                      <tr>
                        <td class="wl-label" style="padding:10px 14px 10px 0;vertical-align:top;font-family:Arial,Helvetica,sans-serif;font-size:13px;color:#6b7280;white-space:nowrap;border-bottom:1px solid #e5e7eb;">{{label}}</td>
                        <td class="wl-value" style="padding:10px 0;vertical-align:top;font-family:Arial,Helvetica,sans-serif;font-size:14px;color:#111827;white-space:pre-wrap;word-break:break-word;border-bottom:1px solid #e5e7eb;">{{#if href}}<a href="{{href}}" style="color:#2563eb;text-decoration:underline;">{{value}}</a>{{else}}{{value}}{{/if}}</td>
                      </tr>
                    {{/each}}
                  </table>
                {{/each}}

                {{#if dashboardUrl}}
                  <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:28px 0 12px;">
                    <tr>
                      <td align="center" bgcolor="#111827" style="border-radius:6px;">
                        <a href="{{dashboardUrl}}" target="_blank" style="display:inline-block;padding:13px 26px;font-family:Arial,Helvetica,sans-serif;font-size:15px;font-weight:bold;color:#ffffff;text-decoration:none;border-radius:6px;">View in dashboard</a>
                      </td>
                    </tr>
                  </table>

                  <p style="margin:0 0 8px;font-size:12px;line-height:1.6;color:#9ca3af;">
                    If the button does not work, paste this into your browser:<br />
                    <a href="{{dashboardUrl}}" style="color:#6b7280;word-break:break-all;">{{dashboardUrl}}</a>
                  </p>
                {{/if}}

                <hr style="border:none;border-top:1px solid #e5e7eb;margin:24px 0 14px;" />

                <p style="margin:0;font-size:12px;line-height:1.6;color:#9ca3af;">
                  Received at {{receivedAt}}{{#if recordId}} &middot; Record {{recordId}}{{/if}}<br />
                  WebLaud
                </p>

              </td>
            </tr>
          </table>

        </td>
      </tr>
    </table>
  </body>
</html>

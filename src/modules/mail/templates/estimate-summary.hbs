{{!--
  The visitor's own calculator estimate, emailed back to them. Everything
  shown comes from the server-side recompute against the live calculator
  config (titles, weeks, cost range) — never from the request — plus `name`,
  already filtered by greetingName(). Keep every interpolation {{escaped}}.

  Layout follows dashboard-alert.hbs: tables, inline styles, bgcolor on the
  CTA cell for Outlook.
--}}
<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Your project estimate</title>
  </head>
  <body style="margin:0;padding:0;background:#f4f4f5;">
    <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="background:#f4f4f5;">
      <tr>
        <td align="center" style="padding:24px 12px;">
          <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="600" style="width:100%;max-width:600px;background:#ffffff;border-radius:10px;">
            <tr>
              <td style="padding:32px;font-family:Arial,Helvetica,sans-serif;">

                <h1 style="margin:0 0 16px;font-size:20px;line-height:1.3;color:#111827;">{{#if name}}{{name}}, here's{{else}}Here's{{/if}} your project estimate</h1>

                <p style="margin:0 0 20px;font-size:15px;line-height:1.6;color:#374151;">
                  Thanks for using the Weblaud project estimator. Here's what you selected and the range it produced, so you have it to hand.
                </p>

                <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="width:100%;border-collapse:collapse;">
                  <tr>
                    <td style="padding:10px 14px 10px 0;vertical-align:top;font-size:13px;color:#6b7280;white-space:nowrap;border-bottom:1px solid #e5e7eb;">Project type</td>
                    <td style="padding:10px 0;vertical-align:top;font-size:14px;color:#111827;border-bottom:1px solid #e5e7eb;">{{projectTypeTitle}}</td>
                  </tr>
                  <tr>
                    <td style="padding:10px 14px 10px 0;vertical-align:top;font-size:13px;color:#6b7280;white-space:nowrap;border-bottom:1px solid #e5e7eb;">Capabilities</td>
                    <td style="padding:10px 0;vertical-align:top;font-size:14px;color:#111827;border-bottom:1px solid #e5e7eb;">{{#if featureTitles.length}}{{#each featureTitles}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}{{else}}None selected{{/if}}</td>
                  </tr>
                  <tr>
                    <td style="padding:10px 14px 10px 0;vertical-align:top;font-size:13px;color:#6b7280;white-space:nowrap;border-bottom:1px solid #e5e7eb;">Delivery pace</td>
                    <td style="padding:10px 0;vertical-align:top;font-size:14px;color:#111827;border-bottom:1px solid #e5e7eb;">{{speedLabel}}</td>
                  </tr>
                  <tr>
                    <td style="padding:10px 14px 10px 0;vertical-align:top;font-size:13px;color:#6b7280;white-space:nowrap;border-bottom:1px solid #e5e7eb;">Indicative timeline</td>
                    <td style="padding:10px 0;vertical-align:top;font-size:14px;color:#111827;font-weight:bold;border-bottom:1px solid #e5e7eb;">{{totalWeeks}} sprint weeks</td>
                  </tr>
                  <tr>
                    <td style="padding:10px 14px 10px 0;vertical-align:top;font-size:13px;color:#6b7280;white-space:nowrap;border-bottom:1px solid #e5e7eb;">Indicative cost range</td>
                    <td style="padding:10px 0;vertical-align:top;font-size:14px;color:#111827;font-weight:bold;border-bottom:1px solid #e5e7eb;">{{costRange}}</td>
                  </tr>
                </table>

                <p style="margin:16px 0 0;font-size:13px;line-height:1.6;color:#6b7280;">
                  This is an indicative estimate from our configured assumptions, not a quote. Scope, timeline and price are confirmed only after we review your requirements.
                </p>

                <p style="margin:24px 0 8px;font-size:15px;line-height:1.6;color:#374151;">
                  The fastest way to turn this into a fixed quote is a 15-minute call:
                </p>

                <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:16px 0 24px;">
                  <tr>
                    <td align="center" bgcolor="#0a84ff" style="border-radius:8px;">
                      <a href="{{bookingUrl}}" target="_blank" style="display:inline-block;padding:13px 26px;font-family:Arial,Helvetica,sans-serif;font-size:15px;font-weight:bold;color:#ffffff;text-decoration:none;border-radius:8px;">Book a call</a>
                    </td>
                  </tr>
                </table>

                <p style="margin:0 0 16px;font-size:14px;line-height:1.6;color:#4b5563;">
                  Or simply reply to this email with any questions.{{#if projectsUrl}} You can also <a href="{{projectsUrl}}" style="color:#2563eb;">see projects we've delivered</a>.{{/if}}
                </p>

                <hr style="border:none;border-top:1px solid #e5e7eb;margin:24px 0 14px;" />

                <p style="margin:0;font-size:12px;line-height:1.6;color:#9ca3af;">
                  You're receiving this because this address was used on the project estimator at weblaud.com. If that wasn't you, you can ignore this email — we won't add you to any list.<br />
                  Weblaud LLC
                </p>

              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>

{{!--
  Automatic reply to a website contact message. Goes to an address typed into
  a public form, so it must carry nothing free-form from the submission — the
  only visitor value is `name`, already filtered by greetingName(). Keep every
  interpolation {{escaped}}.

  Layout follows dashboard-alert.hbs: tables, inline styles, bgcolor on the
  CTA cell for Outlook.
--}}
<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>We got your message</title>
  </head>
  <body style="margin:0;padding:0;background:#f4f4f5;">
    <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="background:#f4f4f5;">
      <tr>
        <td align="center" style="padding:24px 12px;">
          <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="600" style="width:100%;max-width:600px;background:#ffffff;border-radius:10px;">
            <tr>
              <td style="padding:32px;font-family:Arial,Helvetica,sans-serif;">

                <h1 style="margin:0 0 16px;font-size:20px;line-height:1.3;color:#111827;">Thanks for reaching out{{#if name}}, {{name}}{{/if}}</h1>

                <p style="margin:0 0 16px;font-size:15px;line-height:1.6;color:#374151;">
                  Your message has reached the Weblaud team. We typically reply within 24 hours.
                </p>

                <p style="margin:0 0 8px;font-size:15px;line-height:1.6;color:#374151;">
                  Prefer to talk it through? Pick a time for a 15-minute call with us:
                </p>

                <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:20px 0 24px;">
                  <tr>
                    <td align="center" bgcolor="#0a84ff" style="border-radius:8px;">
                      <a href="{{bookingUrl}}" target="_blank" style="display:inline-block;padding:13px 26px;font-family:Arial,Helvetica,sans-serif;font-size:15px;font-weight:bold;color:#ffffff;text-decoration:none;border-radius:8px;">Book a call</a>
                    </td>
                  </tr>
                </table>

                {{#if calculatorUrl}}
                  <p style="margin:0 0 8px;font-size:14px;line-height:1.6;color:#4b5563;">While you wait:</p>
                  <ul style="margin:0 0 16px;padding-left:20px;font-size:14px;line-height:1.8;color:#4b5563;">
                    <li><a href="{{calculatorUrl}}" style="color:#2563eb;">Estimate your project's timeline and budget</a> in about a minute</li>
                    {{#if projectsUrl}}<li><a href="{{projectsUrl}}" style="color:#2563eb;">See projects we've delivered</a></li>{{/if}}
                  </ul>
                {{/if}}

                <hr style="border:none;border-top:1px solid #e5e7eb;margin:24px 0 14px;" />

                <p style="margin:0;font-size:12px;line-height:1.6;color:#9ca3af;">
                  You're receiving this because this address was used on the contact form at weblaud.com. If that wasn't you, you can ignore this email — we won't add you to any list.<br />
                  Weblaud LLC
                </p>

              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>

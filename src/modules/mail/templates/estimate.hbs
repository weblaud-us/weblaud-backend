<h3>New Project Estimate</h3>

<p><strong>Name:</strong> {{name}}</p>
<p><strong>Email:</strong> {{email}}</p>
{{#if company}}<p><strong>Company:</strong> {{company}}</p>{{/if}}
{{#if phone}}<p><strong>Phone:</strong> {{phone}}</p>{{/if}}

<h4>Scope</h4>
<p><strong>Project type:</strong> {{projectType}}</p>
<p><strong>Delivery pace:</strong> {{speed}}</p>
<p><strong>Capabilities:</strong></p>
{{#if features.length}}
<ul>
  {{#each features}}<li>{{this}}</li>{{/each}}
</ul>
{{else}}
<p>None selected</p>
{{/if}}

<h4>Estimate</h4>
<p><strong>Timeline:</strong> {{totalWeeks}} sprint weeks</p>
<p><strong>Investment range:</strong> {{costMin}} – {{costMax}}</p>

{{#if notes}}
<h4>Notes</h4>
<p>{{notes}}</p>
{{/if}}

<p>Received at {{date}}</p>

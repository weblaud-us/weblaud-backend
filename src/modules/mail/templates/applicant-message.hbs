{{!--
  An email an admin writes to a job applicant from /cpadmin/applicants/:id —
  a task/assignment, interview invite, rejection, or anything else. The
  message is admin-authored, but keep every interpolation {{escaped}} anyway.
  `paragraphs` is an array of paragraphs, each an array of lines (single line
  breaks inside a paragraph become <br />).

  Layout follows lead-received.hbs: tables, inline styles, bgcolor on the CTA
  cell for Outlook.
--}}
<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{#if role}}{{role}} at Weblaud{{else}}Weblaud careers{{/if}}</title>
  </head>
  <body style="margin:0;padding:0;background:#f4f4f5;">
    <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="background:#f4f4f5;">
      <tr>
        <td align="center" style="padding:24px 12px;">
          <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="600" style="width:100%;max-width:600px;background:#ffffff;border-radius:10px;">
            <tr>
              <td style="padding:32px;font-family:Arial,Helvetica,sans-serif;">

                {{#if role}}
                  <p style="margin:0 0 12px;font-size:12px;letter-spacing:0.06em;text-transform:uppercase;color:#6b7280;">Your application · {{role}}</p>
                {{/if}}

                <p style="margin:0 0 16px;font-size:15px;line-height:1.6;color:#111827;">Hi{{#if name}} {{name}}{{/if}},</p>

                {{#each paragraphs}}
                  <p style="margin:0 0 16px;font-size:15px;line-height:1.6;color:#374151;">{{#each this}}{{#unless @first}}<br />{{/unless}}{{this}}{{/each}}</p>
                {{/each}}

                {{#if taskUrl}}
                  <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:20px 0 8px;">
                    <tr>
                      <td align="center" bgcolor="#0a84ff" style="border-radius:8px;">
                        <a href="{{taskUrl}}" target="_blank" style="display:inline-block;padding:13px 26px;font-family:Arial,Helvetica,sans-serif;font-size:15px;font-weight:bold;color:#ffffff;text-decoration:none;border-radius:8px;">Open the task</a>
                      </td>
                    </tr>
                  </table>
                  <p style="margin:0 0 16px;font-size:12px;line-height:1.6;color:#6b7280;word-break:break-all;">Or copy this link: {{taskUrl}}</p>
                {{/if}}

                {{#if dueLabel}}
                  <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="margin:8px 0 16px;">
                    <tr>
                      <td style="padding:12px 16px;background:#f9fafb;border:1px solid #e5e7eb;border-radius:8px;font-size:14px;line-height:1.5;color:#111827;">
                        <strong>Due:</strong> {{dueLabel}}
                      </td>
                    </tr>
                  </table>
                {{/if}}

                <p style="margin:16px 0 0;font-size:15px;line-height:1.6;color:#374151;">
                  Just reply to this email with any questions.<br />
                  — The Weblaud team
                </p>

                <hr style="border:none;border-top:1px solid #e5e7eb;margin:24px 0 14px;" />

                <p style="margin:0;font-size:12px;line-height:1.6;color:#9ca3af;">
                  You're receiving this because you applied for a role at weblaud.com.<br />
                  Weblaud LLC
                </p>

              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
